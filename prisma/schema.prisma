// Supernova — Prisma schema
// Prisma Postgres (single connection string, Edge-compatible via the
// Accelerate-style protocol). Same DATABASE_URL works for runtime and
// `prisma migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Schema follows the Better Auth 1.1.x Prisma adapter convention.

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  profile   Profile?
  people    Person[]
  readings  DailyReading[]
  qa        QaHistory[]
  feedback  DailyFeedback[]
  push      PushSubscription[]
  rate      RateLimit[]
  usage     AiUsage[]
  cache     NumerologyCache[]
  summaries ConversationSummary[]
  journal   JournalEntry[]
  career    CareerEntry[]
  personVibes PersonDailyVibe[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── App tables ─────────────────────────────────────────────────────────────

enum Relationship {
  PARTNER
  PARENT
  CHILD
  SIBLING
  FAMILY
  FRIEND
  COLLEAGUE
  OTHER
}

enum FeedbackRating {
  GREAT
  GOOD
  NEUTRAL
  OFF
  HARD
}

enum AiFeature {
  DAILY
  QA
  RELATIONSHIP
  RECAP
}

enum SummaryKind {
  DAILY
  WEEKLY
  MONTHLY
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  middleName      String?
  lastName        String?
  // Optional nickname / commonly-used name. Some people are called by
  // something quite different from their birth name (e.g. Chinese name vs
  // everyday English nickname). Used to compute Minor numbers — the
  // day-to-day energy of how the person is publicly known.
  nickname        String?
  dob             DateTime @db.Date
  timezone        String   @default("Asia/Jakarta")
  locale          String   @default("id")
  // Free-form notes the user wants the AI to remember about them.
  personalNotes   String?
  // Appearance.
  theme           String   @default("auto") // "light" | "dark" | "auto"
  // AI tone — affects chat / daily reading / About Me voice.
  tone            String   @default("warm") // "warm" | "direct" | "playful"
  // UI preference: hide karmic-debt badges if the user finds them anxious.
  showKarmicDebt  Boolean  @default(true)
  // Optional model override for chat/daily/aboutMe (power-user setting).
  preferredModel  String?
  // Auto-journaling: when on, chat conversations from complete past days
  // are auto-clustered by topic + turned into journal entries without the
  // user manually selecting messages. Off by default — opt-in.
  autoJournal     Boolean  @default(false)
  // Local-time reminder ("HH:mm" in user's timezone) — delivery via web push.
  reminderEnabled Boolean  @default(false)
  reminderTime    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profile")
}

model NumerologyCache {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  compound   Int
  reduced    Int
  isMaster   Boolean  @default(false)
  karmicDebt Int?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("numerology_cache")
}

model Person {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  middleName   String?
  lastName     String?
  // Optional nickname / call-by name — see Profile.nickname for context.
  nickname     String?
  dob          DateTime     @db.Date
  relationship Relationship
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dailyVibes PersonDailyVibe[]

  @@index([userId])
  @@map("person")
}

// On-demand "vibe of the day" snapshot for a Person. Generated the first time
// the user taps the AI button on /people/[id] for that calendar date in their
// own timezone, then cached so re-opens that day don't re-bill the model.
model PersonDailyVibe {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  // Date anchored in the user's local timezone.
  date         DateTime @db.Date
  locale       String
  body         String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([personId, date])
  @@index([userId, createdAt])
  @@map("person_daily_vibe")
}

model DailyReading {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The "day" anchored in the user's timezone, stored as a date-only marker.
  date            DateTime @db.Date
  locale          String
  contextSnapshot Json
  body            String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_reading")
}

model QaHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId        String?
  question        String
  answer          String
  contextSnapshot Json
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("qa_history")
}

model DailyFeedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  rating    FeedbackRating
  note      String?
  tags      String[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_feedback")
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  p256dh       String
  auth         String
  enabledKinds String[] @default([])
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([userId, bucket, windowStart])
  @@index([userId])
  @@map("rate_limit")
}

model AiUsage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AiFeature
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal   @db.Decimal(10, 6)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// Hierarchical conversation summaries — daily roll up to weekly, weekly to
// monthly. Created lazily by the chat endpoint when a period boundary is
// crossed. Lets the chatbot stay context-aware over months without re-reading
// every turn.
model ConversationSummary {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        SummaryKind
  // UTC-anchored day marker: start of the period (Mon for weekly, 1st for monthly).
  periodStart DateTime    @db.Date
  // Inclusive last day of the period.
  periodEnd   DateTime    @db.Date
  summary     String
  turnCount   Int         @default(0)
  createdAt   DateTime    @default(now())

  @@unique([userId, kind, periodStart])
  @@index([userId, kind, periodStart])
  @@map("conversation_summary")
}

// Journal entries — batches of chat turns the user explicitly chose to
// remember, synthesized into a first-person narrative in the user's tone.
// Sources are snapshotted so the entry survives chat-history deletion.
model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // First-person narrative generated at journaling time from the source
  // turns. The user's tone preference (warm/direct/playful) shapes voice.
  narrative  String
  // JSON array of { question, answer, createdAt, turnId } in chronological
  // order — fallback content if narrative is empty + audit trail.
  sources    Json
  // Earliest and latest createdAt across the source turns; lets the page
  // group journal entries by the chat-day they came from.
  rangeStart DateTime
  rangeEnd   DateTime
  // Optional extra note the user adds when journaling (future use).
  note       String?
  // CBT-style 2-3 sentence gentle reframe of what came up in the entry,
  // generated alongside the narrative. Voiced as Supernova (not the user)
  // — contrasts the first-person narrative above so the user sees both
  // "what I'm processing" and "how it looks from outside".
  reframe    String?
  // Primary emotion label ("anxious", "grateful", "stuck", etc.) extracted
  // by the AI. Used for pattern surfacing across entries.
  emotion    String?
  // Primary theme label ("work", "relationship", "health", "family", etc.).
  theme      String?
  // Action items extracted from the entry. JSON array of:
  //   { id, title, completed, completedAt?, createdAt }
  // Each item is a concrete, achievable thing the user can do. Stored
  // inline because they're tightly coupled to the entry and the MVP
  // doesn't need to query across all open items yet.
  actionItems Json     @default("[]")
  addedAt    DateTime @default(now())

  @@index([userId, addedAt(sort: Desc)])
  @@map("journal_entry")
}

// Career entries — user's work history rows (parsed from a PDF resume
// they uploaded, or eventually entered manually). Each row carries a
// snapshotted match score against one of the 7 vocation fields from
// lib/numerology/talents.ts. Rebuilt wholesale on every upload —
// users get one resume snapshot at a time.
model CareerEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String?
  // Year-month is enough; day stored as 1 for simplicity. End is null
  // when the role is current.
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  // Short 1-2 sentence summary lifted from the resume bullets.
  description String?
  // One of the 7 TalentVocationId values — chosen by the parser based
  // on the role title + description.
  vocationId  String
  // Snapshot of the vocation rating for this role (0-100).
  matchScore  Float
  // Short AI-written note about why this role fits / mis-fits given
  // the user's strongest digits. Optional.
  insight     String?
  createdAt   DateTime  @default(now())

  @@index([userId, startDate(sort: Desc)])
  @@map("career_entry")
}
