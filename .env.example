# --- Database (Postgres) ---
# Standard Postgres connection string. Used for both runtime and migrations.
# Format: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) — OPTIONAL ---
# Auth uses email + password (no email needed to sign in).
# Resend is reserved for M7 weekly recap emails. Leave blank in dev.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Web push (set in M8) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Cron (Vercel) ---
CRON_SECRET=
