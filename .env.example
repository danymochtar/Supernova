# --- Database (Prisma Postgres) ---
# Single connection string from your Prisma Postgres database.
# Format: prisma+postgres://accelerate.prisma-data.net/?api_key=...
# Get it from console.prisma.io after creating a Prisma Postgres database.
# Used for both runtime (Node + Edge) and migrations.
DATABASE_URL=

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) ---
# MVP: use Resend sandbox sender. Magic links only deliver to the Resend account owner's email
# until a real sending domain is verified.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Encryption (PII at rest) ---
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Web push (set in M8) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Cron (Vercel) ---
CRON_SECRET=
